# Public URL of the deployed site (used for metadata, sitemap and OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Keystatic GitHub mode. Set these in production only: when
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG is set in a production build, the
# dashboard commits to GitHub; otherwise it reads and writes local files.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
