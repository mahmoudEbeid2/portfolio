# Public URL of the deployed site (used for metadata, sitemap and OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas connection string (the database name is set in code)
MONGODB_URI=

# Dashboard login (Auth.js + GitHub OAuth app). ADMIN_EMAIL must be a verified
# address on the GitHub account; nobody else can sign in.
ADMIN_EMAIL=
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Dashboard uploads (Cloudinary). The cloud name is also read at build time, to
# allow this account's images in next/image.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email copy of contact messages (Resend). Messages are always saved
# to the dashboard inbox; these only add an email notification.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: a sender on a domain verified in Resend (defaults to onboarding@resend.dev)
CONTACT_FROM_EMAIL=
