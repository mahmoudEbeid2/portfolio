# Public URL of the deployed site (used for metadata, sitemap and OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas connection string (the database name is set in code)
MONGODB_URI=

# Dashboard login (Auth.js + GitHub OAuth app). ADMIN_EMAIL must be a verified
# address on the GitHub account; nobody else can sign in.
ADMIN_EMAIL=
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Contact form (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: a sender on a domain verified in Resend (defaults to onboarding@resend.dev)
CONTACT_FROM_EMAIL=

# Keystatic GitHub mode. Set these in production only: when
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG is set in a production build, the
# dashboard commits to GitHub; otherwise it reads and writes local files.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
